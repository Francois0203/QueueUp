# Port the server listens on
PORT=3000

# Public address of this site, used for guest links / QR codes.
# Leave empty locally: it auto-detects this computer's Wi-Fi address (http://192.168.x.x:3000).
# In production set your https domain, e.g. https://queueup.example.com
PUBLIC_URL=

# Spotify redirect URI that every DJ adds to their own Spotify app.
# Leave empty: defaults to PUBLIC_URL + /auth/spotify/callback when PUBLIC_URL is https,
# otherwise http://127.0.0.1:PORT/auth/spotify/callback (Spotify rejects "localhost").
SPOTIFY_REDIRECT_URI=

# Set to 1 when running behind a reverse proxy / load balancer (nginx, ALB, Caddy),
# so rate limits use the real client IP from X-Forwarded-For.
TRUST_PROXY=

# Where parties are saved. Defaults to ./data
DATA_DIR=

# Key that encrypts saved parties (PINs, Spotify tokens). 32 random bytes, base64 or hex.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# In production, keep it in a secret store (e.g. AWS Secrets Manager / SSM), NOT on the same disk.
# Leave empty locally: a key file is generated in DATA_DIR.
DATA_ENCRYPTION_KEY=

# --- Legal: shown in /terms and /privacy. Fill in before going public. ---
OPERATOR_NAME=
OPERATOR_CONTACT=
OPERATOR_ADDRESS=
GOVERNING_LAW=
HOSTING_PROVIDER=
