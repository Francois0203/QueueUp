# Port the server listens on
PORT=3000

# PIN the DJ uses to unlock /dj. If empty, a random PIN is generated on first run
# and printed in the console (it is saved in data/state.json).
DJ_PIN=

# The address guests' phones can reach. Used for the QR code.
# Leave empty to auto-detect this computer's LAN address (http://192.168.x.x:3000).
# Use your tunnel / deployed URL here when hosting publicly (must be https for real use).
PUBLIC_URL=

# --- Spotify (optional) ---------------------------------------------------
# Create an app at https://developer.spotify.com/dashboard and add the redirect URI
# below to it EXACTLY. Spotify no longer accepts "localhost" — use 127.0.0.1 or https.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/auth/spotify/callback
