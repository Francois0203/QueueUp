# Copy to .env for a PRODUCTION build on your machine (npm run build / npm run deploy).
# Local development (npm run dev) needs none of this: it runs offline on the Firebase emulators.
# In GitHub Actions these come from repository secrets/variables instead (see README).

# Firebase web app config (Firebase console > Project settings > Your apps > Web app).
# Not secret (it ships to every browser), but keep it out of git anyway.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# Optional: reCAPTCHA Enterprise site key for App Check (blocks scripted abuse).
FIREBASE_APPCHECK_SITE_KEY=

# Optional: your public address if not https://<project-id>.web.app (e.g. a custom domain).
PUBLIC_URL=

# Shown on the Terms and Privacy pages.
OPERATOR_NAME=
OPERATOR_CONTACT=
OPERATOR_ADDRESS=
GOVERNING_LAW=
