rules_version = '2';

// Browsers may only READ. Every write goes through the "api" Cloud Function, which checks
// permissions, validates input and rate-limits. Default: everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function djDoc(code) { return get(/databases/$(database)/documents/parties/$(code)/private/dj); }
    function isDj(code) { return signedIn() && request.auth.uid in djDoc(code).data.djUids; }

    match /parties/{code} {
      // Get one party by its code; listing every party is not allowed.
      allow get: if signedIn();

      // Requests are public within a party (title, votes, and a name only if the DJ allows it).
      match /requests/{id} {
        allow read: if signedIn();
      }

      // Requester names for the DJ.
      match /requestMeta/{id} {
        allow read: if isDj(code);
      }

      // DJ data: PIN, blocked guests, Spotify account name. Signed-in DJs of this party only.
      match /private/dj {
        allow get: if signedIn() && request.auth.uid in resource.data.djUids;
      }

      // private/secrets (Spotify tokens, signing key) and guests: no client access at all.
    }
  }
}
